module tests

// SFNT tables read raw: the `head` table's 54 bytes and what they hold, compared with what FreeType
// read of the face; other tables; a table the face lacks; tags that are not four ASCII characters.
import dev.avinlang.freetype.{invalidArgument, tableMissing}

@test("Kaisei Decol's head table is 54 bytes, version 1.0, with the magic number")
headTable()
  val head = made(kaisei().sfntTable("head"))
  assertEq(head.length, 54)
  assertEq(u16(head, 0), 1)
  assertEq(u16(head, 2), 0)
  assertEq(u32(head, 12), long(1594834165))

@test("the head table holds the face's units per em and bounding box")
headTableAgreesWithFace()
  val face = kaisei()
  val head = made(face.sfntTable("head"))
  assertEq(u16(head, 18), face.unitsPerEm())
  val box = face.boundingBox()
  assertEq(long(i16(head, 36)), box.xMin)
  assertEq(long(i16(head, 38)), box.yMin)
  assertEq(long(i16(head, 40)), box.xMax)
  assertEq(long(i16(head, 42)), box.yMax)

@test("the head table read twice is the same bytes, and is a copy of the font file's")
headTableTwice()
  val face = kaisei()
  val a = made(face.sfntTable("head"))
  val b = made(face.sfntTable("head"))
  assertEq(a.toVector, b.toVector)
  a(0) = byte(9)
  assertEq(u16(made(face.sfntTable("head")), 0), 1)
  val file = bytesOf(kaiseiPath)
  assertEq(file.slice(268, 268 + 54).toVector, b.toVector)

@test("other tables are read at their lengths: OS/2, hhea and maxp")
otherTables()
  val face = kaisei()
  assertEq(made(face.sfntTable("OS/2")).length, 96)
  val hhea = made(face.sfntTable("hhea"))
  assertEq(hhea.length, 36)
  assertEq(i16(hhea, 4), face.ascender())
  assertEq(i16(hhea, 6), face.descender())
  val maxp = made(face.sfntTable("maxp"))
  assertEq(long(u16(maxp, 4)), face.glyphCount())

@test("PT Sans's kern table, which Kaisei Decol lacks, is read whole")
kernTable()
  val kern = made(ptSans().sfntTable("kern"))
  assert(kern.length > 4)
  assertEq(u16(kern, 0), 0)

@test("a table the face does not have is Err, table-missing, from FT_Load_Sfnt_Table")
absentTable()
  val r = kaisei().sfntTable("kern")
  assertEq(code(r), tableMissing)
  assertEq(call(r), "FT_Load_Sfnt_Table")
  assertEq(code(kaisei().sfntTable("fvar")), tableMissing)
  assertEq(code(kaisei().sfntTable("zzzz")), tableMissing)
  assertEq(code(kaisei().sfntTable("    ")), tableMissing)

@test("a table's tag is case-sensitive")
caseSensitiveTag()
  assertEq(code(kaisei().sfntTable("HEAD")), tableMissing)

@test("a tag that is not four ASCII characters is Err, invalid-argument")
badTags()
  val face = kaisei()
  assertEq(code(face.sfntTable("")), invalidArgument)
  assertEq(code(face.sfntTable("hea")), invalidArgument)
  assertEq(code(face.sfntTable("heads")), invalidArgument)
  assertEq(code(face.sfntTable("hé")), invalidArgument)
  assertEq(code(face.sfntTable("héa")), invalidArgument)
  assertEq(code(face.sfntTable("あ")), invalidArgument)
  assertEq(call(face.sfntTable("")), "FT_Load_Sfnt_Table")

@test("a variable font has the fvar table a static one lacks")
fvarTable()
  val fvar = made(quicksand().sfntTable("fvar"))
  assertEq(u16(fvar, 0), 1)
  assertEq(u16(fvar, 8), 1)
