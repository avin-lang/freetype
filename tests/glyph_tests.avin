module tests

// Sizes, character maps and glyphs: a face set to a size, its glyphs looked up, loaded and rendered,
// and the measures of what the glyph slot holds.
import dev.avinlang.freetype.{
  Big5, Face, LoadFlags, Lcd, LcdV, Light, Mono, Sdf, Normal, Unicode, invalidArgument
}

// The face of `path` with the glyph of `c` loaded and rendered at `pixels` pixels high.
private rendered(path: string, pixels: int, c: char) -> Face =
  val face = sized(path, pixels)
  made(face.loadChar(c))
  made(face.renderGlyph())
  face

@test("a pixel size sets the face's measures, scaled from its font units")
pixelSizes()
  val face = sized(kaiseiPath, 100)
  val m = face.sizeMetrics()
  assertEq(m.xPpem, 100)
  assertEq(m.yPpem, 100)
  assertEq(m.ascender, long(116 * 64))
  assertEq(m.descender, long(-29 * 64))
  assertEq(m.height, long(145 * 64))
  assertEq(m.maxAdvance, long(100 * 64))
  assertEq(m.xScale, m.yScale)
  assert(419429 <= m.xScale <= 419431)

@test("a width or height of 0 is the other")
pixelSizesOneZero()
  val face = kaisei()
  made(face.setPixelSizes(40, 0))
  assertEq(face.sizeMetrics().yPpem, 40)
  made(face.setPixelSizes(0, 24))
  assertEq(face.sizeMetrics().xPpem, 24)

@test("a char size in points at a resolution sets the pixels per em")
charSizes()
  val face = kaisei()
  made(face.setCharSize(12, 12, 144, 144))
  assertEq(face.sizeMetrics().yPpem, 24)
  made(face.setCharSize(10, 0))
  assertEq(face.sizeMetrics().xPpem, 10)
  assertEq(face.sizeMetrics().yPpem, 10)
  made(face.setCharSize(10.5, 21, 72, 72))
  assertEq(face.sizeMetrics().xPpem, 11)
  assertEq(face.sizeMetrics().yPpem, 21)

@test("the last size set is the one the face has")
sizesReplaced()
  val face = kaisei()
  made(face.setPixelSizes(0, 10))
  made(face.setPixelSizes(0, 80))
  assertEq(face.sizeMetrics().yPpem, 80)

@test("a character's glyph index is the cmap's, the missing glyph's is 0, and a code's is the same")
charIndices()
  val face = kaisei()
  val a = face.charIndex('A')
  assert(a > 0)
  assert(face.charIndex('あ') > 0)
  assert(face.charIndex('漢') > 0)
  assert(face.charIndex('B') != a)
  assertEq(face.charIndex('\u{10FFFF}'), 0)
  assertEq(face.charIndex('\u{0}'), face.codeIndex(0))
  assertEq(face.codeIndex(long(int('A'))), a)
  assertEq(face.codeIndex(long(65536) * 65536 - 1), 0)

@test("a glyph's name finds its index")
nameIndices()
  val face = ptSans()
  assert(face.hasGlyphNames())
  assertEq(face.nameIndex("A"), face.charIndex('A'))
  assertEq(face.nameIndex("space"), face.charIndex(' '))
  assertEq(face.nameIndex("no-such-glyph"), 0)
  assertEq(face.nameIndex(""), 0)

@test("the character map is walked in order of code, from the first to the last")
characterWalk()
  val face = ptSans()
  val first = face.firstChar().get
  assertEq(first.1, face.codeIndex(first.0))
  val all = face.characters()
  assert(all.length > 100)
  assertEq(all(0), first)
  for i in 1 ..< all.length
    assert(all(i - 1).0 < all(i).0)
    assert(all(i).1 > 0)
  assert(all.contains((long(int('A')), face.charIndex('A'))))
  assertEq(face.nextChar(all(all.length - 1).0), None)
  assertEq(face.nextChar(first.0), Some(all(1)))

@test("Kaisei Decol's map has its kana and kanji")
kaiseiCharacters()
  val face = kaisei()
  val codes = face.characters().map(p -> p.0)
  assert(codes.contains(long(int('あ'))))
  assert(codes.contains(long(int('漢'))))
  assert(codes.length > 5000)

@test("selecting the Unicode map is Ok, and one the face lacks is Err, invalid-argument")
selectCharmaps()
  val face = kaisei()
  made(face.selectCharmap(Unicode))
  assert(face.charIndex('A') > 0)
  val r = face.selectCharmap(Big5)
  assertEq(code(r), invalidArgument)
  assertEq(call(r), "FT_Select_Charmap")

@test("a loaded glyph is the one asked for, and its metrics are in 26.6 pixels")
loadCharMetrics()
  val face = sized(kaiseiPath, 64)
  made(face.loadChar('A'))
  assertEq(face.glyphIndex(), face.charIndex('A'))
  val m = face.glyphMetrics()
  assert(m.width > 0)
  assert(m.height > 0)
  assert(m.horiAdvance > 0)
  assertEq(m.horiAdvance % 64, 0)
  assert(m.horiBearingY > 0)
  assertEq(face.advance().x, m.horiAdvance)
  assertEq(face.advance().y, 0)
  assert(face.linearHoriAdvance() > 0)

@test("a full-width kana at one em is one em across")
kanaAdvance()
  val face = sized(kaiseiPath, 64)
  made(face.loadChar('あ'))
  assertEq(face.advance().x, 64 * 64)
  val linear = int(face.linearHoriAdvance())
  assert(64 * 65536 - 16 <= linear <= 64 * 65536 + 16)

@test("a glyph loaded unscaled is measured in the font's units")
loadNoScale()
  val face = kaisei()
  made(face.loadChar('あ', LoadFlags.noScale))
  assertEq(face.glyphMetrics().horiAdvance, 1000)
  made(face.loadGlyph(face.charIndex('A'), LoadFlags.noScale | LoadFlags.noHinting))
  assertEq(face.glyphIndex(), face.charIndex('A'))

@test("loading by index and by character loads one glyph")
loadGlyphByIndex()
  val face = sized(ptSansPath, 32)
  made(face.loadGlyph(face.charIndex('g')))
  val byIndex = face.glyphMetrics()
  made(face.loadChar('g'))
  assertEq(face.glyphMetrics(), byIndex)

@test("an index past the face's glyphs is Err, invalid-argument, from FT_Load_Glyph")
loadGlyphPastEnd()
  val face = sized(kaiseiPath, 32)
  val r = face.loadGlyph(int(face.glyphCount()))
  assertEq(code(r), invalidArgument)
  assertEq(code(face.loadGlyph(65535)), invalidArgument)
  assertEq(call(r), "FT_Load_Glyph")
  made(face.loadGlyph(int(face.glyphCount()) - 1))

@test("the missing glyph loads, for a character the face has none for")
loadMissingChar()
  val face = sized(kaiseiPath, 32)
  made(face.loadChar('\u{10FFFF}'))
  assertEq(face.glyphIndex(), 0)

@test("a rendered glyph's bitmap is as tall and wide as its metrics say, placed by its bearings")
renderedBitmap()
  val face = rendered(kaiseiPath, 64, 'A')
  val m = face.glyphMetrics()
  val rows = face.bitmapRows()
  val width = face.bitmapWidth()
  assert(rows > 0)
  assert(width > 0)
  assertEq(long(rows), (m.height + 63) / 64)
  assertEq(long(width), (m.width + 63) / 64)
  assert(face.bitmapPitch() >= width)
  assertEq(face.bitmapGrays(), 256)
  assertEq(long(face.bitmapLeft()), m.horiBearingX / 64)
  assertEq(long(face.bitmapTop()), m.horiBearingY / 64)

@test("a larger size renders a larger bitmap")
renderedSizes()
  val small = rendered(kaiseiPath, 16, 'あ')
  val large = rendered(kaiseiPath, 128, 'あ')
  assert(large.bitmapRows() > small.bitmapRows() * 6)
  assert(large.bitmapWidth() > small.bitmapWidth() * 6)

@test("a glyph rendered in one bit to a pixel packs eight pixels to a byte")
renderMono()
  val face = sized(kaiseiPath, 64)
  made(face.loadChar('A', LoadFlags.targetMono))
  made(face.renderGlyph(Mono))
  assert(face.bitmapRows() > 0)
  assert(face.bitmapPitch() >= (face.bitmapWidth() + 7) / 8)
  assert(face.bitmapPitch() < face.bitmapWidth())

@test("a glyph rendered in the light mode is a grey bitmap")
renderLight()
  val face = sized(ptSansPath, 40)
  made(face.loadChar('W', LoadFlags.targetLight))
  made(face.renderGlyph(Light))
  assertEq(face.bitmapGrays(), 256)
  assert(face.bitmapRows() > 0)

@test("a glyph rendered for horizontal subpixels is three bytes to a pixel across")
renderLcd()
  val face = sized(ptSansPath, 40)
  made(face.loadChar('W'))
  made(face.renderGlyph())
  val (rows, width) = (face.bitmapRows(), face.bitmapWidth())
  made(face.loadChar('W', LoadFlags.targetLcd))
  made(face.renderGlyph(Lcd))
  assertEq(face.bitmapWidth() % 3, 0)
  assert(face.bitmapWidth() >= width * 3)
  assert(face.bitmapRows() >= rows)
  assert(face.bitmapPitch() >= face.bitmapWidth())

@test("a glyph rendered for vertical subpixels is three rows to a pixel")
renderLcdV()
  val face = sized(ptSansPath, 40)
  made(face.loadChar('W'))
  made(face.renderGlyph())
  val rows = face.bitmapRows()
  made(face.loadChar('W', LoadFlags.targetLcdV))
  made(face.renderGlyph(LcdV))
  assertEq(face.bitmapRows() % 3, 0)
  assert(face.bitmapRows() >= rows * 3)

@test("a glyph rendered as a signed distance field is a grey bitmap with a margin")
renderSdf()
  val face = sized(ptSansPath, 40)
  made(face.loadChar('W'))
  made(face.renderGlyph())
  val (rows, width) = (face.bitmapRows(), face.bitmapWidth())
  made(face.loadChar('W'))
  made(face.renderGlyph(Sdf))
  assert(face.bitmapRows() > rows)
  assert(face.bitmapWidth() > width)

@test("a glyph loaded with `render` is rendered by the load")
loadAndRender()
  val face = sized(ptSansPath, 40)
  made(face.loadChar('W', LoadFlags.render))
  assert(face.bitmapRows() > 0)
  made(face.renderGlyph(Normal))
  assert(face.bitmapRows() > 0)

@test("a space renders an empty bitmap, and still moves the pen")
spaceBitmap()
  val face = rendered(kaiseiPath, 64, ' ')
  assertEq(face.bitmapRows(), 0)
  assertEq(face.bitmapWidth(), 0)
  assertEq(face.bitmapPitch(), 0)
  assert(face.advance().x > 0)
  assertEq(face.glyphMetrics().width, 0)

@test("a glyph's bitmap is replaced by the next load")
bitmapReplaced()
  val face = rendered(kaiseiPath, 64, 'あ')
  assert(face.bitmapRows() > 0)
  made(face.loadChar(' '))
  made(face.renderGlyph())
  assertEq(face.bitmapRows(), 0)
  made(face.loadChar('漢'))
  made(face.renderGlyph())
  assert(face.bitmapRows() > 0)

@test("load flags combine with `|`, and contain what they combine")
loadFlagsCombine()
  val both = LoadFlags.noScale | LoadFlags.noHinting
  assert(both.contains(LoadFlags.noScale))
  assert(both.contains(LoadFlags.noHinting))
  assert(!both.contains(LoadFlags.render))
  assertEq(LoadFlags.default.bits, 0)
  assertEq(LoadFlags.default | LoadFlags.render, LoadFlags.render)
  assertEq(LoadFlags.render | LoadFlags.render, LoadFlags.render)
  assert(LoadFlags.noScale != LoadFlags.noHinting)
  assert(LoadFlags.targetMono != LoadFlags.targetNormal)
  assertEq(LoadFlags.targetNormal.bits, 0)
