@c(const: "FT_Err_Invalid_Argument")
val invalidArgument: int
@c(const: "FT_Err_Unimplemented_Feature")
val unimplementedFeature: int
@c(const: "FT_Err_Invalid_Table")
val invalidTable: int
@c(const: "FT_Err_Invalid_Glyph_Index")
val invalidGlyphIndex: int
@c(const: "FT_Err_Invalid_Character_Code")
val invalidCharacterCode: int
@c(const: "FT_Err_Invalid_Glyph_Format")
val invalidGlyphFormat: int
@c(const: "FT_Err_Cannot_Render_Glyph")
val cannotRenderGlyph: int
@c(const: "FT_Err_Invalid_Pixel_Size")
val invalidPixelSize: int
@c(const: "FT_Err_Invalid_Handle")
val invalidHandle: int
@c(const: "FT_Err_Invalid_Face_Handle")
