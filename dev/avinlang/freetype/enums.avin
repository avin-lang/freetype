module dev.avinlang.freetype

// FreeType's enumerations, mirrored as types of variants, and its error codes and flags, as
// constants measured from its headers.

// How a glyph's outline is turned into pixels.
@c(enum: "FT_Render_Mode", prefix: "FT_RENDER_MODE_")
data RenderMode
  // Eight-bit coverage, 256 levels of grey.
  Normal
  // Eight-bit coverage, hinted lightly: vertically only.
  Light
  // One bit to a pixel.
  Mono
  // Coverage for horizontal subpixels: three bytes to a pixel.
  Lcd
  // Coverage for vertical subpixels: three rows to a pixel.
  LcdV
  // A signed distance field.
  Sdf

// How a bitmap holds its pixels.
@c(enum: "FT_Pixel_Mode", prefix: "FT_PIXEL_MODE_")
data PixelMode
  None
  // One bit to a pixel, the leftmost in the high bit.
  Mono
  // One byte to a pixel: its coverage.
  Gray
  // Two bits to a pixel.
  Gray2
  // Four bits to a pixel.
  Gray4
  // Three bytes to a pixel, one for each horizontal subpixel.
  Lcd
  // Three rows to a pixel, one for each vertical subpixel.
  LcdV
  // Four bytes to a pixel, blue, green, red and alpha, premultiplied.
  Bgra

// What a glyph in a glyph slot is stored as.
@c(enum: "FT_Glyph_Format", prefix: "FT_GLYPH_FORMAT_")
data GlyphFormat
  None
  Composite
  Bitmap
  Outline
  Plotter
  Svg

// What a kerning distance is measured in.
@c(enum: "FT_Kerning_Mode", prefix: "FT_KERNING_")
data KerningMode
  // Scaled and rounded to whole pixels, in 26.6.
  Default
  // Scaled and not rounded, in 26.6.
  Unfitted
  // In the font's own units.
  Unscaled

// The encoding of a face's character map.
@c(enum: "FT_Encoding", prefix: "FT_ENCODING_")
data Encoding
  None
  MsSymbol
  Unicode
  Sjis
  Prc
  Big5
  Wansung
  Johab
  AdobeStandard
  AdobeExpert
  AdobeCustom
  @c("FT_ENCODING_ADOBE_LATIN_1")
  AdobeLatin1
  @c("FT_ENCODING_OLD_LATIN_2")
  OldLatin2
  AppleRoman

