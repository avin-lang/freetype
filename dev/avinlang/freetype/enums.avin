@c(const: "FT_LOAD_DEFAULT")
private val ftLoadDefault: int
@c(const: "FT_LOAD_NO_SCALE")
private val ftLoadNoScale: int
@c(const: "FT_LOAD_NO_HINTING")
private val ftLoadNoHinting: int
@c(const: "FT_LOAD_RENDER")
private val ftLoadRender: int
@c(const: "FT_LOAD_NO_BITMAP")
private val ftLoadNoBitmap: int
@c(const: "FT_LOAD_VERTICAL_LAYOUT")
private val ftLoadVerticalLayout: int
@c(const: "FT_LOAD_FORCE_AUTOHINT")
private val ftLoadForceAutohint: int
@c(const: "FT_LOAD_PEDANTIC")
private val ftLoadPedantic: int
@c(const: "FT_LOAD_NO_RECURSE")
private val ftLoadNoRecurse: int
@c(const: "FT_LOAD_IGNORE_TRANSFORM")
private val ftLoadIgnoreTransform: int
@c(const: "FT_LOAD_MONOCHROME")
private val ftLoadMonochrome: int
@c(const: "FT_LOAD_LINEAR_DESIGN")
private val ftLoadLinearDesign: int
@c(const: "FT_LOAD_NO_AUTOHINT")
private val ftLoadNoAutohint: int
@c(const: "FT_LOAD_COLOR")
private val ftLoadColor: int
@c(const: "FT_LOAD_COMPUTE_METRICS")
private val ftLoadComputeMetrics: int
@c(const: "FT_LOAD_BITMAP_METRICS_ONLY")
private val ftLoadBitmapMetricsOnly: int
@c(const: "FT_LOAD_TARGET_NORMAL")
private val ftLoadTargetNormal: int
@c(const: "FT_LOAD_TARGET_LIGHT")
private val ftLoadTargetLight: int
@c(const: "FT_LOAD_TARGET_MONO")
private val ftLoadTargetMono: int
@c(const: "FT_LOAD_TARGET_LCD")
private val ftLoadTargetLcd: int
@c(const: "FT_LOAD_TARGET_LCD_V")
private val ftLoadTargetLcdV: int

// How a glyph is loaded: FreeType's `FT_LOAD_*` flags, combined with `|`. `LoadFlags.default` is
// none of them.
data LoadFlags(bits: int)

impl LoadFlags
  // Both flags' bits.
  |(other: LoadFlags) -> LoadFlags = LoadFlags(bits | other.bits)

  // Whether every bit of `other` is set here.
  contains(other: LoadFlags) -> bool = (bits & other.bits) == other.bits

object LoadFlags
  // Scaled to the face's size, hinted, and not rendered.
  val default: LoadFlags = LoadFlags(ftLoadDefault)
  // In the font's own units, unhinted and unscaled.
  val noScale: LoadFlags = LoadFlags(ftLoadNoScale)
  val noHinting: LoadFlags = LoadFlags(ftLoadNoHinting)
  // Rendered to a bitmap as it is loaded, in the target's render mode.
  val render: LoadFlags = LoadFlags(ftLoadRender)
  val noBitmap: LoadFlags = LoadFlags(ftLoadNoBitmap)
  val verticalLayout: LoadFlags = LoadFlags(ftLoadVerticalLayout)
  val forceAutohint: LoadFlags = LoadFlags(ftLoadForceAutohint)
  val pedantic: LoadFlags = LoadFlags(ftLoadPedantic)
  val noRecurse: LoadFlags = LoadFlags(ftLoadNoRecurse)
  val ignoreTransform: LoadFlags = LoadFlags(ftLoadIgnoreTransform)
  val monochrome: LoadFlags = LoadFlags(ftLoadMonochrome)
  val linearDesign: LoadFlags = LoadFlags(ftLoadLinearDesign)
  val noAutohint: LoadFlags = LoadFlags(ftLoadNoAutohint)
  val color: LoadFlags = LoadFlags(ftLoadColor)
  val computeMetrics: LoadFlags = LoadFlags(ftLoadComputeMetrics)
  val bitmapMetricsOnly: LoadFlags = LoadFlags(ftLoadBitmapMetricsOnly)
  // The hinting each render mode is made for.
  val targetNormal: LoadFlags = LoadFlags(ftLoadTargetNormal)
  val targetLight: LoadFlags = LoadFlags(ftLoadTargetLight)
  val targetMono: LoadFlags = LoadFlags(ftLoadTargetMono)
  val targetLcd: LoadFlags = LoadFlags(ftLoadTargetLcd)
  val targetLcdV: LoadFlags = LoadFlags(ftLoadTargetLcdV)
